NEXT_PUBLIC_APP_NAME=Real Estate ERP
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=10
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
# date-fns pattern: dd/MM/yyyy | MM/dd/yyyy | yyyy-MM-dd
NEXT_PUBLIC_DEFAULT_DATE_FORMAT=dd/MM/yyyy

# Frontend origin (for docs / absolute links). CORS allowlist is NOT set here —
# put this exact origin on the backend as CORS_ALLOWED_ORIGINS (comma-separated).
# localhost vs 127.0.0.1 are different origins.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API base URL (axios). Example: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

NEXT_PUBLIC_SESSION_COOKIE=re_erp_session
# Restrict by HTTP referrer in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_NOTIFICATION_SHOW_TIME_MS=4000

# Backend (separate repo) — required when connecting FE with credentials:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.yourdomain.com
# CORS_ALLOW_CREDENTIALS=True
