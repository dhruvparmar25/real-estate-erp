# App
NEXT_PUBLIC_APP_NAME=Real Estate ERP
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=10
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
# date-fns pattern — dd/MM/yyyy | MM/dd/yyyy | yyyy-MM-dd
NEXT_PUBLIC_DEFAULT_DATE_FORMAT=dd/MM/yyyy

# URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Include /api if your Django routes are under that prefix
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Auth
NEXT_PUBLIC_SESSION_COOKIE=re_erp_session

# Maps — restrict HTTP referrer in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Toasts (ms)
NEXT_PUBLIC_NOTIFICATION_SHOW_TIME_MS=4000
# Optional; defaults to base × 1.25 and × 1.5
NEXT_PUBLIC_TOAST_WARNING_DURATION_MS=5000
NEXT_PUBLIC_TOAST_ERROR_DURATION_MS=6000
# top-right | top-left | top-center | bottom-right | bottom-left | bottom-center
NEXT_PUBLIC_TOAST_POSITION=top-right
NEXT_PUBLIC_TOAST_LIMIT=4
NEXT_PUBLIC_TOAST_OFFSET_TOP=16
NEXT_PUBLIC_TOAST_OFFSET_RIGHT=16

# Django backend (separate repo) — set on server, not in this file
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# CORS_ALLOW_CREDENTIALS=True
